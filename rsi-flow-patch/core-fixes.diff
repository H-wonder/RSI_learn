     public synchronized void addExecuteNode(Source source) {
-        if (source.equals(executeQueue.peek()))
+        // A node may be reached by several async branches (especially a JOIN
+        // with target strategy "close"). Deduplicate the whole queue, not only
+        // the head, so a JOIN is not executed once per branch.
+        if (executeQueue.contains(source)) {
             return;
+        }
         executeQueue.add(source);
     }
 
